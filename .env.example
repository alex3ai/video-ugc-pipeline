# Chave de API do Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Configurações da API de vídeo
VIDEO_API_URL=https://api.example.com
VIDEO_API_KEY=your_video_api_key_here

# Configurações do Google Drive
GOOGLE_CREDENTIALS_PATH=path/to/google_credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Configurações do banco de dados
DATABASE_URL=sqlite:///./video_ugc_pipeline.db

# Configurações de timeout (em segundos)
VIDEO_RENDER_TIMEOUT=600
REQUEST_TIMEOUT=30

# Número máximo de tentativas para operações que podem falhar
MAX_RETRIES=3
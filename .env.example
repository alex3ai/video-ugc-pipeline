# LLM Configuration - Choose one of the options below

# Option 1: Grok API (requires paid account)
GROK_API_KEY=your_xai_grok_api_key_here
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta

# Option 2: Hugging Face (free tier available)
HF_API_KEY=your_hugging_face_api_key_here
HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_INFERENCE_API_URL=https://huggingface.co
HF_PROVIDER=featherless-ai

# Option 3: Legacy Llama API (alternative to HF_API_KEY)
LLAMA_API_KEY=your_llama_api_key_here

# If you want to force using free providers only (skip Grok entirely)
GROK_USE_FREE_ONLY=false

# Video Generation API Configuration
VIDEO_API_URL=https://your_video_generation_api_url.com
VIDEO_API_KEY=your_video_api_key_here

# Google Drive Configuration for uploading generated videos
GOOGLE_CREDENTIALS_PATH=path/to/your/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_where_videos_will_be_stored

# Database Configuration (default uses local SQLite)
DATABASE_URL=sqlite:///./video_ugc_pipeline.db

# Timeouts and Retries Configuration
VIDEO_RENDER_TIMEOUT=600  # 10 minutes timeout for video rendering (in seconds)
REQUEST_TIMEOUT=30        # 30 seconds for API requests (in seconds)
MAX_RETRIES=3             # Number of retries for failed requests
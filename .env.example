# Hugging Face Configuration
HF_API_KEY=your_hugging_face_api_key_here
HF_TOKEN=your_hugging_face_token_here  # Alternative format for HF token

# Hugging Face Model Configuration
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_PROVIDER=huggingface

# Video Generation Configuration
HF_SPACE_MODEL=AlexMendes33/Wan-AI-Wan2.1-T2V-1.3B

# Google Drive Configuration
GOOGLE_CREDENTIALS_PATH=path/to/your/google_credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Database Configuration
DATABASE_URL=sqlite:///./video_ugc_pipeline.db

# Video Generation Settings
VIDEO_RENDER_TIMEOUT=600
REQUEST_TIMEOUT=30
MAX_RETRIES=3
VIDEO_DURATION_PER_SEGMENT=5
CROSSFADE_DURATION=1.0
TEMP_VIDEO_DIR=

# Optional: Grok Configuration (requires paid account)
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta
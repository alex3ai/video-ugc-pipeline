# Opção para forçar o uso apenas de provedores gratuitos (pula o Grok mesmo que a chave esteja definida)
# Defina como "true" para usar apenas Hugging Face Llama 3 gratuitamente
GROK_USE_FREE_ONLY=true

# Chave de API do Grok (xAI) - opcional (requer conta paga)
# Descomente as linhas abaixo se quiser usar o Grok
# GROK_API_KEY=your_xai_api_key_here
# GROK_API_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-beta

# Chave de API do Llama 3 via Hugging Face Inference API - gratuito
LLAMA_API_KEY=your_huggingface_api_key_here
LLAMA_API_BASE_URL=https://api-inference.huggingface.co/models/meta-llama/Meta-Llama-3-8B-Instruct

# Alternativamente, usar a variável HF_API_KEY (padrão Hugging Face)
# HF_API_KEY=your_huggingface_api_key_here

# Configurações da API de vídeo
VIDEO_API_URL=https://api.example.com
VIDEO_API_KEY=your_video_api_key_here

# Configurações do Google Drive
GOOGLE_CREDENTIALS_PATH=path/to/credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Configurações do banco de dados
DATABASE_URL=sqlite:///./video_ugc_pipeline.db

# Configurações de timeout
VIDEO_RENDER_TIMEOUT=600
REQUEST_TIMEOUT=30

# Número máximo de tentativas para operações que podem falhar
MAX_RETRIES=3